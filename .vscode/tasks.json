{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "wmlab: 环境自检",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": ["scripts/00_check_env.py"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "wmlab: 随机基线 (01)",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": ["scripts/01_random_baseline.py"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "wmlab: 训练世界模型 (02)",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": ["scripts/02_train_world_model.py"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": []
        },
        {
            "label": "wmlab: 长视界 H* (02 · Pendulum)",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": ["scripts/02_train_world_model.py", "--config", "configs/pendulum.yaml",
                     "--tag", "02_world_model_pendulum"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "wmlab: 通信接入 (04 · X24/X25/X26)",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": ["-u", "scripts/04_channel_tracking.py", "--config", "configs/channel.yaml",
                     "--tag", "04_channel"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "wmlab: 通信接入 · 冒烟 (04 --quick)",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": ["-u", "scripts/04_channel_tracking.py", "--config", "configs/channel.yaml",
                     "--quick", "--tag", "04_smoke"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "wmlab: 上云训练 (cuda)",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": ["scripts/02_train_world_model.py", "--device", "cuda", "--epochs", "60"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            // 仓库刻意不依赖 pytest（见 tests/ 文件头说明），所以自检走脚本直跑
            "label": "wmlab: 自检测试（11 个用例，不依赖 pytest）",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": ["tests/test_channel_and_aoi.py"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": "test",
            "problemMatcher": []
        },
        {
            // 本机执行环境会注入死代理 (127.0.0.1:<随机端口>) 覆盖 git 的 7897，
            // 导致 push 静默失败（exit=128 且无输出）。必须先真删环境变量再推。
            // 末尾用 ls-remote 实时核对远端，不要看 git status 的 [ahead N]（沙箱里不落盘）。
            "label": "wmlab: 安全推送（先清死代理再 push）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile", "-NoLogo", "-Command",
                "foreach ($v in 'http_proxy','https_proxy','HTTP_PROXY','HTTPS_PROXY','ALL_PROXY','all_proxy') { Remove-Item -Path ('Env:' + $v) -ErrorAction SilentlyContinue }; git push; Write-Host '--- 远端 main ---'; git ls-remote origin refs/heads/main"
            ],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        }
    ]
}
